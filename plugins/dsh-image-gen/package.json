{
  "name": "dsh-image-gen",
  "version": "0.1.1",
  "type": "module",
  "description": "Image generation tools for DeepSeekRuntime via OpenAI-compatible Images API (gpt-image series); endpoint and model are configurable",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek-runtime",
    "plugin",
    "image-generation",
    "image-editing",
    "gpt-image",
    "openai-images"
  ],
  "homepage": "https://github.com/fujunchao/dsh-plugins/tree/main/plugins/dsh-image-gen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fujunchao/dsh-plugins.git",
    "directory": "plugins/dsh-image-gen"
  },
  "bugs": {
    "url": "https://github.com/fujunchao/dsh-plugins/issues"
  },
  "author": {
    "name": "Fu Junchao"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "category": "tools",
      "order": 40
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
