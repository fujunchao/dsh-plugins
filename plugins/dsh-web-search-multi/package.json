{
  "name": "dsh-web-search-multi",
  "version": "0.3.2",
  "type": "module",
  "description": "Multi-backend web search provider for DeepSeekRuntime (Tavily, Grok/xAI, OpenAI, Gemini)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek-runtime",
    "plugin",
    "web-search",
    "tavily",
    "grok",
    "gemini"
  ],
  "homepage": "https://github.com/fujunchao/dsh-plugins/tree/main/plugins/dsh-web-search-multi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fujunchao/dsh-plugins.git",
    "directory": "plugins/dsh-web-search-multi"
  },
  "bugs": {
    "url": "https://github.com/fujunchao/dsh-plugins/issues"
  },
  "author": {
    "name": "Fu Junchao"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "category": "tools",
      "order": 50
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
